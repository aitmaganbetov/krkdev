MYSQL_ROOT_PASSWORD=__REQUIRED_STRONG_DB_ROOT_PASSWORD__
MYSQL_DATABASE=krk_monitoring
MYSQL_ROOT_HOST=%

DB_HOST=db
DB_PORT=3306
DB_NAME=krk_monitoring
DB_USER=root
DB_PASSWORD=__REQUIRED_STRONG_DB_PASSWORD__

READONLY_DB_HOST=host.docker.internal
READONLY_DB_PORT=6080
READONLY_DB_NAME=nitro
READONLY_DB_USER=__REQUIRED_READONLY_USER__
READONLY_DB_PASSWORD=__REQUIRED_READONLY_PASSWORD__

LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3307
LOCAL_DB_NAME=krk_monitoring
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=__REQUIRED_STRONG_LOCAL_DB_PASSWORD__

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type

SECRET_KEY=__REQUIRED_32PLUS_CHAR_RANDOM_SECRET__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=krk_access_token
# true для HTTPS (по умолчанию); false только для локальной разработки по http
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# Лимит неудачных входов: на пару логин+IP и на IP за окно, затем блокировка источника
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_FAILED_PER_IP=50
LOGIN_LOCKOUT_SECONDS=900
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__REQUIRED_STRONG_ADMIN_PASSWORD__